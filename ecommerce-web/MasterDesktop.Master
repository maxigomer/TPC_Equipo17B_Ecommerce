<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterDesktop.master.cs" Inherits="ecommerce_web.MasterDesktop" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>
<body>
    <form id="form1" runat="server">
        <nav class="navbar navbar-expand-lg bg-dark">
            <div class="container-fluid">
                <div class="row w-100 align-items-center">
                    <div class="col-2">
                        <a class="navbar-brand p-1">
                            <img src="Assets/notion.svg" alt="Logo" width="50" height="50" />
                        </a>

                    </div>

                    <div class="col-8">
                        <div class="d-flex">
                            <asp:TextBox ID="txtBuscar" CssClass="form-control me-2" placeholder="Buscar" runat="server" />
                            <asp:Button ID="btnBuscar" Text="Buscar" CssClass="btn btn-outline-info" runat="server" />

                        </div>
                    </div>

                    <div class="col-2 d-flex justify-content-end">

                        <div class="d-flex">
                            <img src="Assets/person.svg" class="bi bi-person m-1" alt="login" width="30" height="30" />
                            <asp:Button ID="btnLogin" Text="Login" CssClass="btn btn-outline-info" runat="server" OnClick="btnLogin_Click" />

                        </div>
                        <div class="me-2 ps-3">
                            <a href="#" >
                                <img src="Assets/cart.svg" class="bi bi-cart m-1" alt="Cart" width="30" height="30" />
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" href="Default.aspx">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Categoria</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Categoria</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Categoria</a>
                    </li>

                </ul>


            </div>
        </nav>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
