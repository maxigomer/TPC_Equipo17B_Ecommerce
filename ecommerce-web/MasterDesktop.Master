<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="MasterDesktop.master.cs" Inherits="ecommerce_web.MasterDesktop" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="shortcut icon" href="/Assets/icon.ico" type="image/x-icon">

</head>
<body class="d-flex flex-column min-vh-100">
    <form id="form1" runat="server" class="d-flex flex-column flex-grow-1">
        <nav class="navbar navbar-expand-lg bg-dark">
            <div class="container-fluid">
                <div class="row w-100 align-items-center">
                    <div class="col-2">
                        <div class="d-flex align-items-center">
                            <a class="navbar-brand d-flex align-items-center"
                                href='<%= ResolveUrl("~/Default.aspx") %>'>

                                <img src='<%= ResolveUrl("~/Assets/PacheTech1.png") %>' height="75" class="me-2" />
                                <%--  <img src='<%= ResolveUrl("~/Assets/Logo.png") %>' width="55" height="55" class="me-2" /> --%>
                                <%--  <span class="text-white fw-bold fs-4"> C# Store </span> --%>

                            </a>
                        </div>

                    </div>

                    <div class="col-8">
                        <div class="d-flex">
                            <asp:TextBox ID="txtBuscar" CssClass="form-control me-2" placeholder="Buscar" runat="server" />
                            <asp:Button ID="btnBuscar" Text="Buscar" CssClass="btn btn-outline-info" runat="server" OnClick="btnBuscar_Click" />

                        </div>
                    </div>

                    <div class="col-2 d-flex justify-content-end">

                        <div class="d-flex">
                            <img src='<%= ResolveUrl("~/Assets/person.svg") %>' class="bi bi-person m-1" alt="login" width="30" height="30" />
                            <asp:Button ID="btnLogin" Text="Login" CssClass="btn btn-outline-info" runat="server" OnClick="btnLogin_Click" />

                        </div>
                        <div class="me-2 ps-3">
                            <a href='<%=ResolveUrl("~/Cart/Cart.aspx") %>' class="d-inline-block position-relative">
                                <img src='<%= ResolveUrl("~/Assets/cart.svg") %>' class="bi bi-cart m-1" alt="Cart" width="30" height="30" />

                                <asp:Label runat="server" ID="lblCantidadCarrito" CssClass="cart-badge position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" />
                            </a>

                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link active" href='<%= ResolveUrl("~/Default.aspx") %>'>Inicio</a>
                    </li>

                    <asp:Repeater runat="server" ID="rpColecciones">
                        <ItemTemplate>
                            <li class="nav-item">
                                <a runat="server" class="nav-link active" href='<%# ResolveUrl("Colecciones.aspx") + "?id=" + Eval("IdCriterio") + "&criterio=" + Eval("Criterio") %>'><%#Eval("Nombre") %></a>
                            </li>
                        </ItemTemplate>
                    </asp:Repeater>

                    <%--                    <li class="nav-item">
                        <a class="nav-link active" href="#">Categoria</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Categoria</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="#">Categoria</a>
                    </li>--%>
                </ul>


            </div>
        </nav>
        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>

    <div style="display: flex; justify-content: center; align-items: center;">
        <img src="/Assets/PacheTech2.png" alt="Logo" width="200" />
    </div>


    <footer class="bg-dark text-light mt-auto py-4">
        <div class="container text-center">
            <!--<h4 class="fw-bold">PacheTech</h4> -->

            <p class="mb-1">
                Tu tienda online de tecnología
            </p>

            <small class="text-secondary">Proyecto Académico - Programación III © 2026
            </small>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>
